    "distance_weights": "euclidean_chord_on_normalized_raw_embeddings_or_euclidean_on_residual_pca",
    "landmarks": 128,
    "all_pairs_shortest_paths": false,
    "test_graph_fit_in_primary": false
  },
  "local_subspace": {
